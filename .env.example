# TMDB API v3 key — https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=

# Spool: the video platform this site shows creator uploads from (its PUBLIC API only,
# no keys needed). Locally Spool's web app runs on port 3000; this site runs on 3001.
NEXT_PUBLIC_SPOOL_API_URL=http://localhost:3000
